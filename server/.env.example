# Copy to .env and adjust as needed
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string

# --- Supabase (Postgres + Auth) ---
# Project Settings → API / Database. Server-side only — nothing here ships to
# the browser, and Express is the only database client.
#   DATABASE_URL         the pooler connection string (transaction mode, :6543)
#   DIRECT_DATABASE_URL  the direct connection (:5432) for migrations and the ETL
#   SUPABASE_PROJECT_REF the <ref> in https://<ref>.supabase.co
# TEST_SUPABASE_PROJECT_REF is the only project the test suite will run
# against — it truncates every table, so never set it to production's ref.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
DATABASE_URL=
DIRECT_DATABASE_URL=
TEST_SUPABASE_PROJECT_REF=

# --- Background jobs (pg-boss; see docs/jobs.md) ---
# BOSS_DATABASE_URL  defaults to DIRECT_DATABASE_URL (then DATABASE_URL). It MUST
#                    be a session-capable connection: the direct connection on
#                    :5432 or Supabase's *session-mode* pooler. NEVER the :6543
#                    transaction pooler — pg-boss relies on session state
#                    (advisory locks, LISTEN, prepared statements) and breaks
#                    there in ways that only show under load.
# BOSS_ENABLED       on by default. Set to 0 and restart to run every job inline
#                    instead (the rollback switch); queued jobs stay in the
#                    database untouched until it is turned back on.
BOSS_DATABASE_URL=
BOSS_ENABLED=1

JWT_EXPIRES_IN=7d
# The origin the browser uses: CORS, cookies and the links in emails. Express
# serves the client itself (Vite runs embedded in development), so this is the
# server's own origin — the same host and PORT as above, never a separate port.
CLIENT_ORIGIN=http://localhost:5000
NODE_ENV=development

# Reverse proxies in front of the app (0 = none). Login rate limiting keys on
# the client IP, so behind nginx/Cloudflare/a PaaS router set this to the real
# hop count (usually 1) or every visitor shares one bucket.
TRUST_PROXY=0

# How many instances of the server this deployment runs (default 1; anything
# invalid also means 1). Config caches stay in sync across instances over
# Postgres LISTEN/NOTIFY, on BOSS_DATABASE_URL (or DIRECT_DATABASE_URL). Above
# 1 the server refuses to boot unless Bunny Storage is configured: the local-
# disk media fallback is per instance, so an upload would exist on only one.
REPLICAS=1

# Only read by the one-shot MongoDB → Postgres ETL (`npm run etl`). The app
# itself never touches MongoDB; leave this unset unless you are re-running it.
# MONGO_URI=mongodb://127.0.0.1:27017/growth-scholar

# Where the rate limiters (login, register, password reset, checkout, blog
# comments, reports) keep their counters:
#   postgres  shared in DATABASE_URL (schema rate_limit, created on first use —
#             the role needs CREATE on the database, or a pre-created schema).
#             Required for more than one instance.
#   memory    per process, as before.
# Blank = postgres in production, memory under test, in development and when
# DATABASE_URL is unset. Any other value stops the server at boot. If the
# database fails, requests pass unlimited and the error is reported (at most
# once a minute). See docs/deploy.md.
RATE_LIMIT_STORE=

# --- Production-only / feature secrets ---
# Leave blank in development. Never commit real values.

# Required by `npm run seed` (min 8 chars) — the shared password for every
# seeded account. The seeder refuses to run without it. Use a random value:
#   openssl rand -base64 24
SEED_PASSWORD=

# The single real operator account (task 13). `npm run seed:admin` creates it
# with SEED_PASSWORD. Must be a monitored mailbox — password reset and every
# operational notification go here.
ADMIN_EMAIL=team@growthscholar.in

# Bunny Stream playback signing (task 8)
BUNNY_LIBRARY_ID=
BUNNY_SECURITY_KEY=

# Bunny Stream management API (task 22 — in-app video upload from the admin
# curriculum editor). The library API key lives at Stream → the library → API.
# Server-side only; never ships to the browser. Leave blank to fall back to
# pasting GUIDs by hand.
BUNNY_API_KEY=

# Shared secret for the encoding-status webhook, since Bunny signs nothing:
# set the library's webhook URL to  https://<site>/api/webhooks/bunny?token=<this>
# Generate one:  openssl rand -hex 24
BUNNY_WEBHOOK_TOKEN=

# Bunny Storage — where the blog's Media Library keeps its images. This is
# Bunny's *file storage* product, a separate zone from the Stream library above.
#
#   ZONE      Storage → the zone's name.
#   PASSWORD  Storage → the zone → FTP & API Access → Password. It grants write
#             access to the whole zone and has no per-file scoping, which is why
#             image uploads proxy through the server instead of going straight
#             from the browser the way video does.
#   REGION    The zone's main region code — '' for the default German zone, or
#             one of uk, se, ny, la, sg, syd, br, jh. A mismatch answers 404.
#   HOST      The Pull Zone hostname images are served from, e.g.
#             growth-scholar.b-cdn.net. The storage endpoint itself is not public.
#
# All blank means images are written to the server's own disk under
# server/uploads/media, which a redeploy replaces. These are also editable in
# /admin/integrations, which wins over anything set here.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_HOST=

# Resend transactional email (task 7)
# MAIL_FROM must be an address on a domain verified in Resend, otherwise mail is
# only delivered to the Resend account owner. See docs/email-dns.md.
#   MAIL_FROM="Growth Scholar <no-reply@send.growthscholar.in>"
RESEND_API_KEY=
MAIL_FROM=

# Absolute base URL used for links inside emails. Falls back to CLIENT_ORIGIN.
PUBLIC_URL=

# Sender identity printed in the footer of every transactional email — Indian
# consumers expect a named business, and bulk filters weight its presence.
# Mirrors client/src/data/legal.js; fill both when the entity is confirmed.
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=support@growthscholar.in

# UPI checkout (task 10)
UPI_VPA=
UPI_PAYEE_NAME=

# Per-route SEO tags (title, description, canonical, Open Graph, JSON-LD)
# written into the head of the built index.html for every page request. On
# unless set to 0, which serves the built file untouched. Canonical and og:url
# are built from PUBLIC_URL above, so set that to the live origin.
SEO_INJECT=1

# Cloudflare edge-cache purge (optional). When an admin changes a course,
# program, workshop, post, setting or taxonomy term, the purge-cloudflare-cache
# job purges the affected pages (absolute URLs built from PUBLIC_URL) — or the
# whole zone for settings and taxonomy. Leave either blank and the job is a
# no-op that logs once per process. The token needs only Zone > Cache Purge on
# this zone. See docs/jobs.md.
CF_ZONE_ID=
CF_API_TOKEN=

# --- Feature flags ---
# Modules whose admin UI is complete but whose backing behaviour is not. Unset
# (or anything other than 1/true/yes/on) hides the module everywhere: admin nav,
# client routes and the API, which 404s. No source was deleted — set a flag to
# 1 and restart the server to bring the module back.
#
# FEATURE_FUNNELS       needs public /f/* funnel pages before the analytics mean
#                       anything; today every view and lead count is invented.
# FEATURE_EMAIL         needs a mail transport wired into broadcasts; today
#                       "Send" marks a campaign sent and mails no one.
# FEATURE_GAMIFICATION  needs something that actually awards seeds; today every
#                       real learner sits at 0 forever.
FEATURE_FUNNELS=0
FEATURE_EMAIL=0
FEATURE_GAMIFICATION=0

# Razorpay (task 16). KEY_ID is public and ships in the client bundle by design;
# the other two never leave the server. WEBHOOK_SECRET is set separately in the
# Razorpay dashboard, so payments can be live while the webhook verifies
# nothing — see docs/razorpay.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
INVOICE_PREFIX=GS

# Error tracking (task 19). Unset = errors are logged locally only, nothing
# breaks. Use two Sentry projects so server 500s and client render errors do not
# share an issue stream. See docs/observability.md.
SENTRY_DSN=
RELEASE=

# Root key for encrypting the credentials an admin stores at /admin/integrations
# (utils/secretBox.js). Falls back to JWT_SECRET when unset, so existing
# deployments keep working — but set it to its own value before storing live
# payment keys, so rotating one does not invalidate the other.
CONFIG_SECRET=
